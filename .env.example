# Supabase project URL. Example shape: https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose in the browser. RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Not used by this app. Do not put the service role key in client code or commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=
